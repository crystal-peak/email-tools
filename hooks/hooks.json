{
  "description": "Plugin hooks for email-tools — validates gws CLI command syntax",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gws-command-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
